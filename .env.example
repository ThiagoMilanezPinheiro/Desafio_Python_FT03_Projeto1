# Copie para .env e ajuste. NUNCA versione o .env real.

# --- Databricks (opcional para execução local) ---
DATABRICKS_HOST=https://<seu-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_SECRET_SCOPE=seismic

# --- API de origem (USGS Earthquake Catalog) ---
API_BASE_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
API_TIMEOUT=30
API_MAX_RETRIES=5
API_BACKOFF_FACTOR=2
API_RATE_LIMIT_PER_SEC=2

# --- Janela de extração (YYYY-MM-DD) ---
START_DATE=2024-01-01
END_DATE=2024-01-07
MIN_MAGNITUDE=2.5

# --- Saída ---
OUTPUT_PATH=output/delta_seismic_gold
DQ_REPORT_PATH=output/dq_report.json
