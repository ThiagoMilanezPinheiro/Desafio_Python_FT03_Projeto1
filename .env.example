# Copie para .env e ajuste. NUNCA versione o .env real.
# As duas APIs usadas são públicas e não exigem chave. Se uma fonte futura exigir,
# adicione aqui (ex.: MY_API_KEY=) e leia via src/config.get_setting().

# --- APIs de origem ---
USGS_API_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
WORLDBANK_API_URL=https://api.worldbank.org/v2

# --- Resiliência HTTP ---
API_TIMEOUT=30
API_MAX_RETRIES=5
API_BACKOFF_FACTOR=2
API_RATE_LIMIT_PER_SEC=2

# --- Janela de extração (YYYY-MM-DD; END_DATE exclusivo) ---
START_DATE=2024-01-01
END_DATE=2024-04-01
EXTRACT_WINDOW_DAYS=7
MIN_MAGNITUDE=2.5
POPULATION_YEARS=2018:2024

# --- Saída ---
OUTPUT_PATH=output/delta_seismic_gold
DQ_REPORT_PATH=output/dq_report.json

# --- Databricks (opcional) ---
DATABRICKS_SECRET_SCOPE=seismic
